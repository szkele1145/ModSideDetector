# --- 运行时产物 ---------------------------------------------------------
# config.json 是「本机记忆」（上次扫描目录等），每台机器不同，不入库
config.json

# 缓存：内含从 mcmod.cn 抓取的「运行环境」数据，其许可为 BY-NC-SA 3.0，
# **既不随 exe 分发，也不入库**
cache/

# 扫描输出（报告体积可能不小）
out/
dist/
build/
*.spec

# --- 本地工具链（体积大，不入库）----------------------------------------
# tools/ 放的是便携版 ffmpeg 之类，动辄上百 MB，绝不提交
tools/

# --- 宣传片 / 站点渲染的中间产物 ----------------------------------------
promo/frames/
promo/audio/*.wav
promo/work/
site-preview/

# --- Python -------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# --- 编辑器 / 系统 ------------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini
