# --- 运行时产物 ---------------------------------------------------------
# config.json 是「本机记忆」（上次扫描目录等），每台机器不同，不入库
config.json

# 缓存：内含从 mcmod.cn 抓取的「运行环境」数据，其许可为 BY-NC-SA 3.0，
# **既不随 exe 分发，也不入库**
cache/

# 扫描输出（报告体积可能不小）
out/
/dist/
/build/
*.spec

# --- 本地工具链（体积大，不入库）----------------------------------------
# tools/ 放的是便携版 ffmpeg 之类，动辄上百 MB，绝不提交
tools/*
# 例外：文档站生成器是纯文本脚本（几 KB），必须入库才能重新生成 docs/ 站点
!tools/build_site.py

# --- 宣传片 / 站点渲染的中间产物 ----------------------------------------
# 逐帧截图（2455 张 ~600MB）与渲染中间产物：**绝不入库**
promo/work/
promo/frames/
promo/audio/*.wav
site-preview/

# 成片 mp4：体积大（每版 ~12MB），按项目所有者要求不入库，自行传 B 站 / 发 Release
promo/dist/*.mp4

# 归档的旧版产物
promo/_old/

# 鸿蒙字体的**原始全量字库**（8MB）；实际用的是子集化后内嵌进 HTML 的 woff2（77KB）
promo/assets/fonts/HarmonyOS_Sans_SC.ttf

# 配音对比样音（试听用，不是成片依赖）
promo/audio/compare/

# --- Python -------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# --- 编辑器 / 系统 ------------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini

# 修正时间轴前备份的旧 manifest（诊断用，不入库）
promo/audio/manifest.old.json
