  "shots": {
    "male": [
      {
        "n": 1,
        "start": 0,
        "d": 4860,
        "file": "01.mp3",
        "text": "ModSideDetector 是一个检测 mod 侧别的软件"
      },
      {
        "n": 2,
        "start": 4860,
        "d": 4580,
        "file": "02.mp3",
        "text": "它判断每个 mod 属于客户端还是服务端"
      },
      {
        "n": 3,
        "start": 9440,
        "d": 3090,
        "file": "03.mp3",
        "text": "装多了，玩家白下载"
      },
      {
        "n": 4,
        "start": 12530,
        "d": 3060,
        "file": "04.mp3",
        "text": "服务端缺 mod，会崩"
      },
      {
        "n": 5,
        "start": 15590,
        "d": 3040,
        "file": "05.mp3",
        "text": "这就是玩家看到的报错"
      },
      {
        "n": 6,
        "start": 18630,
        "d": 2850,
        "file": "06.mp3",
        "text": "每个 mod 都有侧别"
      },
      {
        "n": 7,
        "start": 21480,
        "d": 3620,
        "file": "07.mp3",
        "text": "Modrinth 的字段，作者自己填"
      },
      {
        "n": 8,
        "start": 25100,
        "d": 3110,
        "file": "08.mp3",
        "text": "人工分类，一个个查"
      },
      {
        "n": 9,
        "start": 28210,
        "d": 3420,
        "file": "09.mp3",
        "text": "一百五十一个，手工来一遍"
      },
      {
        "n": 11,
        "start": 34330,
        "d": 3210,
        "file": "11.mp3",
        "text": "查 Modrinth，命中八成"
      },
      {
        "n": 12,
        "start": 37540,
        "d": 2940,
        "file": "12.mp3",
        "text": "mcmod 补剩下三成"
      },
      {
        "n": 13,
        "start": 40480,
        "d": 2610,
        "file": "13.mp3",
        "text": "判完直接出报告"
      },
      {
        "n": 14,
        "start": 43090,
        "d": 3140,
        "file": "14.mp3",
        "text": "界面里冲突行会高亮"
      },
      {
        "n": 15,
        "start": 46230,
        "d": 2850,
        "file": "15.mp3",
        "text": "双击一行就能改判"
      },
      {
        "n": 16,
        "start": 49080,
        "d": 3090,
        "file": "16.mp3",
        "text": "四个数据源的覆盖率"
      },
      {
        "n": 17,
        "start": 52170,
        "d": 3520,
        "file": "17.mp3",
        "text": "人工确认基准集，全对"
      },
      {
        "n": 18,
        "start": 55690,
        "d": 3300,
        "file": "18.mp3",
        "text": "误判纯服务端，零个"
      },
      {
        "n": 19,
        "start": 58990,
        "d": 3780,
        "file": "19.mp3",
        "text": "首次 4 分钟，之后 0.1 秒"
      },
      {
        "n": 20,
        "start": 62770,
        "d": 3180,
        "file": "20.mp3",
        "text": "搜 sodium 出来植物魔法"
      },
      {
        "n": 21,
        "start": 65950,
        "d": 3230,
        "file": "21.mp3",
        "text": "标题校验，宁可不判"
      },
      {
        "n": 22,
        "start": 69180,
        "d": 3540,
        "file": "22.mp3",
        "text": "冲突时不猜，保守判双端"
      },
      {
        "n": 23,
        "start": 72720,
        "d": 4770,
        "file": "23.mp3",
        "text": "exe 可能被杀毒误报，加白名单即可"
      },
      {
        "n": 24,
        "start": 77490,
        "d": 3300,
        "file": "24.mp3",
        "text": "报告能直接喂给 AutoSync"
      },
      {
        "n": 25,
        "start": 80790,
        "d": 3660,
        "file": "25.mp3",
        "text": "开源，仓库和文档在下面"
      }
