  "shots": {
    "male": [
      {
        "n": 1,
        "start": 0,
        "d": 4650,
        "file": "01.mp3",
        "text": "ModSideDetector 是一个检测 mod 侧别的软件",
        "audio_ms": 3530,
        "margin_ms": 1120
      },
      {
        "n": 2,
        "start": 4650,
        "d": 4360,
        "file": "02.mp3",
        "text": "它判断每个 mod 属于客户端还是服务端",
        "audio_ms": 3190,
        "margin_ms": 1170
      },
      {
        "n": 3,
        "start": 9010,
        "d": 2870,
        "file": "03.mp3",
        "text": "装多了，玩家白下载",
        "audio_ms": 1820,
        "margin_ms": 1050
      },
      {
        "n": 4,
        "start": 11880,
        "d": 2800,
        "file": "04.mp3",
        "text": "服务端缺 mod，会崩",
        "audio_ms": 1800,
        "margin_ms": 1000
      },
      {
        "n": 5,
        "start": 14680,
        "d": 2820,
        "file": "05.mp3",
        "text": "这就是玩家看到的报错",
        "audio_ms": 1460,
        "margin_ms": 1360
      },
      {
        "n": 6,
        "start": 17500,
        "d": 2630,
        "file": "06.mp3",
        "text": "每个 mod 都有侧别",
        "audio_ms": 1580,
        "margin_ms": 1050
      },
      {
        "n": 7,
        "start": 20130,
        "d": 3420,
        "file": "07.mp3",
        "text": "Modrinth 的字段，作者自己填",
        "audio_ms": 2210,
        "margin_ms": 1210
      },
      {
        "n": 8,
        "start": 23550,
        "d": 2900,
        "file": "08.mp3",
        "text": "人工分类，一个个查",
        "audio_ms": 1780,
        "margin_ms": 1120
      },
      {
        "n": 9,
        "start": 26450,
        "d": 3230,
        "file": "09.mp3",
        "text": "一百五十一个，手工来一遍",
        "audio_ms": 1900,
        "margin_ms": 1330
      },
      {
        "n": 11,
        "start": 32380,
        "d": 3020,
        "file": "11.mp3",
        "text": "查 Modrinth，命中八成",
        "audio_ms": 1970,
        "margin_ms": 1050
      },
      {
        "n": 12,
        "start": 35400,
        "d": 2730,
        "file": "12.mp3",
        "text": "mcmod 补剩下三成",
        "audio_ms": 1580,
        "margin_ms": 1150
      },
      {
        "n": 13,
        "start": 38130,
        "d": 2390,
        "file": "13.mp3",
        "text": "判完直接出报告",
        "audio_ms": 1200,
        "margin_ms": 1190
      },
      {
        "n": 14,
        "start": 40520,
        "d": 2920,
        "file": "14.mp3",
        "text": "界面里冲突行会高亮",
        "audio_ms": 1580,
        "margin_ms": 1340
      },
      {
        "n": 15,
        "start": 43440,
        "d": 2630,
        "file": "15.mp3",
        "text": "双击一行就能改判",
        "audio_ms": 1460,
        "margin_ms": 1170
      },
      {
        "n": 16,
        "start": 46070,
        "d": 2900,
        "file": "16.mp3",
        "text": "四个数据源的覆盖率",
        "audio_ms": 1510,
        "margin_ms": 1390
      },
      {
        "n": 17,
        "start": 48970,
        "d": 3260,
        "file": "17.mp3",
        "text": "人工确认基准集，全对",
        "audio_ms": 2260,
        "margin_ms": 1000
      },
      {
        "n": 18,
        "start": 52230,
        "d": 3060,
        "file": "18.mp3",
        "text": "误判纯服务端，零个",
        "audio_ms": 2060,
        "margin_ms": 1000
      },
      {
        "n": 19,
        "start": 55290,
        "d": 3540,
        "file": "19.mp3",
        "text": "首次 4 分钟，之后 0.1 秒",
        "audio_ms": 2300,
        "margin_ms": 1240
      },
      {
        "n": 20,
        "start": 58830,
        "d": 2940,
        "file": "20.mp3",
        "text": "搜 sodium 出来植物魔法",
        "audio_ms": 1800,
        "margin_ms": 1140
      },
      {
        "n": 21,
        "start": 61770,
        "d": 3020,
        "file": "21.mp3",
        "text": "标题校验，宁可不判",
        "audio_ms": 2020,
        "margin_ms": 1000
      },
      {
        "n": 22,
        "start": 64790,
        "d": 3350,
        "file": "22.mp3",
        "text": "冲突时不猜，保守判双端",
        "audio_ms": 2160,
        "margin_ms": 1190
      },
      {
        "n": 23,
        "start": 68140,
        "d": 4550,
        "file": "23.mp3",
        "text": "exe 可能被杀毒误报，加白名单即可",
        "audio_ms": 3380,
        "margin_ms": 1170
      },
      {
        "n": 24,
        "start": 72690,
        "d": 3060,
        "file": "24.mp3",
        "text": "报告能直接喂给 AutoSync",
        "audio_ms": 1920,
        "margin_ms": 1140
      },
      {
        "n": 25,
        "start": 75750,
        "d": 3380,
        "file": "25.mp3",
        "text": "开源，仓库和文档在下面",
        "audio_ms": 2380,
        "margin_ms": 1000
      }
